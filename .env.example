# Evidence AI configuration. Copy to .env and edit as needed.
# Every value here has a working default in config.py.

# ---- Local LLM (Ollama) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=300
# Keeps the model resident between queries (default 5m costs a ~14s reload).
OLLAMA_KEEP_ALIVE=30m
# One image costs ~1030 prompt tokens; 4096 leaves too little for evidence.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.0

# ---- Local models ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# GPU is reserved for Ollama; PyTorch stays on CPU.
TORCH_DEVICE=cpu

# ---- Chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---- Retrieval ----
TOP_K=10
RERANK_TOP_K=5

# ---- Relationships ----
RELATED_TO_THRESHOLD=0.70
MAX_RELATIONSHIP_EXPANSION=3

# ---- Generation context ----
MAX_CONTEXT_ITEMS=5
MAX_CONTEXT_CHARS=6000
MAX_INSPECT_IMAGES=1

# ---- Grounding / abstention ----
ABSTENTION_THRESHOLD=-6.0
CITATION_THRESHOLD=0.35

# ---- External binaries ----
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
SOFFICE_CMD=C:\Program Files\LibreOffice\program\soffice.exe

# ---- Offline enforcement (set these to prove no hub access at runtime) ----
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
